# ==============================================================================
# ProyectoFlotaTraccar - Plantilla de Variables de Entorno (.env.example)
# Copie este archivo como .env y ajuste las contraseñas para su entorno local.
# ==============================================================================

# --- Puertos publicados en el Host ---
ODOO_PORT=8070
TRACCAR_WEB_PORT=8082
TRACCAR_GPS_PORT=5055

# --- Versiones de Imágenes Docker ---
POSTGRES_IMAGE_TAG=15
ODOO_IMAGE_TAG=16
TRACCAR_IMAGE_TAG=6.16.0

# --- Servidor PostgreSQL (Superusuario/Administrador) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_master_dev_pass
POSTGRES_DB=postgres

# --- Base de datos y credenciales para Odoo ---
ODOO_DB_NAME=odoo_flota
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=odoo_flota_secret_pass
ODOO_ADMIN_PASSWORD=odoo_master_admin_pwd

# --- Base de datos y credenciales para Traccar ---
TRACCAR_DB_HOST=db
TRACCAR_DB_PORT=5432
TRACCAR_DB_NAME=traccar
TRACCAR_DB_USER=traccar
TRACCAR_DB_PASSWORD=traccar_flota_secret_pass
