<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_fleet_mobile" model="ir.module.category">
        <field name="name">Acceso a Flota</field>
        <field name="sequence">20</field>
    </record>
    <record id="group_mobile_user" model="res.groups">
        <field name="name">Usuario de la aplicación</field>
        <field name="category_id" ref="module_category_fleet_mobile"/>
        <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
    </record>
    <record id="group_fleet_admin" model="res.groups">
        <field name="name">Administrador de Flota</field>
        <field name="category_id" ref="module_category_fleet_mobile"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('fleet.fleet_group_manager'))]"/>
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_fleet_admin'))]"/>
    </record>
</odoo>
