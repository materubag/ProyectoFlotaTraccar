<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_fleet_rutas" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.fleet_rutas</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="85"/>
        <field name="inherit_id" ref="fleet.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='fleet']" position="inside">
                <h2 class="mt16">Personalización de Colores · Transporte UTA</h2>
                <div class="row mt16 o_settings_container" id="fleet_rutas_theme_settings">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <span class="o_form_label">Colores de Acento y Selección</span>
                            <div class="text-muted">
                                Personaliza la paleta visual del Centro de Control de Rutas.
                            </div>
                            <div class="content-group mt8">
                                <div class="row mt4">
                                    <label for="fleet_color_primary" class="col-lg-5 o_light_label"/>
                                    <field name="fleet_color_primary" class="col-lg-7" placeholder="#714b67"/>
                                </div>
                                <div class="row mt4">
                                    <label for="fleet_color_primary_hover" class="col-lg-5 o_light_label"/>
                                    <field name="fleet_color_primary_hover" class="col-lg-7" placeholder="#5d3d54"/>
                                </div>
                                <div class="row mt4">
                                    <label for="fleet_color_primary_soft" class="col-lg-5 o_light_label"/>
                                    <field name="fleet_color_primary_soft" class="col-lg-7" placeholder="#f3ebf1"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <span class="o_form_label">Colores de Estructura y Capas</span>
                            <div class="text-muted">
                                Fondo general, tarjetas/paneles y texto principal.
                            </div>
                            <div class="content-group mt8">
                                <div class="row mt4">
                                    <label for="fleet_color_background" class="col-lg-5 o_light_label"/>
                                    <field name="fleet_color_background" class="col-lg-7" placeholder="#f4f4f4"/>
                                </div>
                                <div class="row mt4">
                                    <label for="fleet_color_card" class="col-lg-5 o_light_label"/>
                                    <field name="fleet_color_card" class="col-lg-7" placeholder="#ffffff"/>
                                </div>
                                <div class="row mt4">
                                    <label for="fleet_color_text" class="col-lg-5 o_light_label"/>
                                    <field name="fleet_color_text" class="col-lg-7" placeholder="#161616"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
