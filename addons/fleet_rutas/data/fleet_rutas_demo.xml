        <!-- 3. RECORRIDOS DE ASIGNACIÓN (Mínimo 2 recorridos)                 -->
        <!-- ═════════════════════════════════════════════════════════════════ -->
        <record id="recorrido_demo_01" model="fleet.recorrido">
            <field name="simulado">True</field>
            <field name="ruta_id" ref="ruta_norte"/>
            <field name="vehicle_id" ref="vehicle_bus_01"/>
            <field name="conductor_id" ref="base.user_admin"/>
            <field name="estado">en_curso</field>
            <field name="fecha_inicio" eval="(datetime.datetime.now() - datetime.timedelta(minutes=20)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="fecha_inicio_real" eval="(datetime.datetime.now() - datetime.timedelta(minutes=18)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="fecha_fin_estimada" eval="(datetime.datetime.now() + datetime.timedelta(minutes=15)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="distancia_real_km">4.850</field>
            <field name="velocidad_promedio_real">35.40</field>
            <field name="notas">Servicio matutino en operación normal.</field>
        </record>

        <record id="recorrido_demo_02" model="fleet.recorrido">
            <field name="simulado">True</field>
            <field name="ruta_id" ref="ruta_sur"/>
            <field name="vehicle_id" ref="vehicle_bus_02"/>
            <field name="conductor_id" ref="base.user_admin"/>
            <field name="estado">programado</field>
            <field name="fecha_inicio" eval="(datetime.datetime.now() + datetime.timedelta(hours=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="fecha_fin_estimada" eval="(datetime.datetime.now() + datetime.timedelta(hours=1, minutes=45)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="notas">Asignado para el turno vespertino de prácticas de laboratorio.</field>
