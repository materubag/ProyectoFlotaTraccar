<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_traccar" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.traccar</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="70"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="Flota Traccar" string="Flota Traccar" data-key="fleet_traccar">
                    <h2>Servidor Traccar GPS</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Conexión con Traccar API</span>
                                <div class="text-muted">
                                    Configuración de la URL del servidor Traccar y credenciales para sincronización REST.
                                </div>
                                <div class="content-group mt8">
                                    <div class="row mt4">
                                        <label for="traccar_server_url" class="col-lg-4 o_light_label"/>
                                        <field name="traccar_server_url" placeholder="http://traccar:8082"/>
                                    </div>
                                    <div class="row mt4">
                                        <label for="traccar_user" class="col-lg-4 o_light_label"/>
                                        <field name="traccar_user" placeholder="admin / usuario@correo.com"/>
                                    </div>
                                    <div class="row mt4">
                                        <label for="traccar_password" class="col-lg-4 o_light_label"/>
                                        <field name="traccar_password" password="True"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
