      "pluginVersion": "10.4.0",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "traccar-pg" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) AS \"Alertas Hoy\"\nFROM tc_events\nWHERE type IN ('deviceOverspeed','deviceStopped','geofenceExit','geofenceEnter')\n  AND eventtime >= CURRENT_DATE;",
          "refId": "A"
        }
      ],
      "title": "Alertas Hoy",
      "type": "stat"
    },
    {
      "collapsed": false,
