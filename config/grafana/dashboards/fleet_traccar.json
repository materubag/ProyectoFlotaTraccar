          "custom": {
            "align": "auto",
            "displayMode": "auto",
            "inspect": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Tipo de Evento" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  { "options": { "deviceOverspeed": { "color": "red", "index": 0, "text": "🚨 Exceso Velocidad" } }, "type": "value" },
                  { "options": { "deviceStopped": { "color": "orange", "index": 1, "text": "⏸ Detenido" } }, "type": "value" },
                  { "options": { "geofenceExit": { "color": "purple", "index": 2, "text": "📤 Salida Geocerca" } }, "type": "value" },
                  { "options": { "geofenceEnter": { "color": "blue", "index": 3, "text": "📥 Entrada Geocerca" } }, "type": "value" },
                  { "options": { "deviceOnline": { "color": "green", "index": 4, "text": "✅ En Línea" } }, "type": "value" },
                  { "options": { "deviceOffline": { "color": "gray", "index": 5, "text": "❌ Fuera de Línea" } }, "type": "value" }
                ]
              },
              { "id": "custom.displayMode", "value": "color-background" }
            ]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 28 },
      "id": 30,
      "options": {
        "footer": { "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true
      },
      "pluginVersion": "10.4.0",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "traccar-pg" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  e.eventtime AS \"Fecha/Hora\",\n  d.name AS \"Vehículo\",\n  e.type AS \"Tipo de Evento\"\nFROM tc_events e\nJOIN tc_devices d ON d.id = e.deviceid\nWHERE e.eventtime BETWEEN $__timeFrom() AND $__timeTo()\nORDER BY e.eventtime DESC\nLIMIT 200;",
          "refId": "A"
        }
      ],
      "title": "Eventos de la Flota",
      "type": "table"
    }
