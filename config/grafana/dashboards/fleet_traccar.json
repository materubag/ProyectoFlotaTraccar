          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 100 }
            ]
          },
          "unit": "velocitykmh"
        },
        "overrides": []
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 17 },
      "id": 20,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "traccar-pg" },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  p.fixtime AS time,\n  d.name AS metric,\n  ROUND((p.speed * 1.852)::numeric, 1) AS value\nFROM tc_positions p\nJOIN tc_devices d ON d.id = p.deviceid\nWHERE p.fixtime BETWEEN $__timeFrom() AND $__timeTo()\n  AND d.disabled = false\nORDER BY p.fixtime ASC;",
          "refId": "A"
        }
      ],
      "title": "Velocidad en el Tiempo por Vehículo",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "id": 103,
      "title": "Alertas y Eventos",
