      "id": 101,
      "title": "Estado en Tiempo Real por Vehículo",
      "type": "row"
    },
    {
      "datasource": { "type": "postgres", "uid": "traccar-pg" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "align": "auto",
            "displayMode": "color-background",
            "inspect": false,
            "minWidth": 80
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 60 },
              { "color": "red", "value": 100 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Estado" },
            "properties": [
              {
                "id": "custom.displayMode",
                "value": "color-background"
              },
              {
                "id": "mappings",
                "value": [
                  { "options": { "En línea": { "color": "green", "index": 0 } }, "type": "value" },
                  { "options": { "Sin señal": { "color": "red", "index": 1 } }, "type": "value" }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Velocidad (km/h)" },
            "properties": [
              {
                "id": "custom.displayMode",
                "value": "gradient-gauge"
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 120
              }
            ]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 6 },
      "id": 10,
      "options": {
        "footer": { "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Última Posición" }]
      },
      "pluginVersion": "10.4.0",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "traccar-pg" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  d.name AS \"Vehículo\",\n  d.uniqueid AS \"IMEI/ID\",\n  ROUND((p.speed * 1.852)::numeric, 1) AS \"Velocidad (km/h)\",\n  ROUND(p.latitude::numeric, 6) AS \"Latitud\",\n  ROUND(p.longitude::numeric, 6) AS \"Longitud\",\n  p.course AS \"Rumbo (°)\",\n  p.fixtime AS \"Última Posición\",\n  CASE\n    WHEN p.fixtime >= NOW() - INTERVAL '10 minutes' THEN 'En línea'\n    ELSE 'Sin señal'\n  END AS \"Estado\"\nFROM tc_devices d\nJOIN tc_positions p ON p.id = d.positionid\nWHERE d.disabled = false\nORDER BY p.fixtime DESC;",
          "refId": "A"
        }
      ],
      "title": "Posición Actual de la Flota",
      "transformations": [
        {
          "id": "sortBy",
          "options": { "fields": [{ "desc": true, "displayName": "Última Posición" }] }
        }
      ],
      "type": "table"
    },
