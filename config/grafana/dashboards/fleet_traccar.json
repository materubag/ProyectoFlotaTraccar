        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "pluginVersion": "10.4.0",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "traccar-pg" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) AS \"En Línea\"\nFROM tc_devices d\nJOIN tc_positions p ON p.id = d.positionid\nWHERE d.disabled = false\n  AND p.fixtime >= NOW() - INTERVAL '10 minutes';",
          "refId": "A"
        }
      ],
      "title": "Vehículos En Línea (últimos 10 min)",
      "type": "stat"
    },
    {
      "datasource": { "type": "postgres", "uid": "traccar-pg" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 60 },
              { "color": "red", "value": 100 }
            ]
          },
          "unit": "velocitykmh"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "pluginVersion": "10.4.0",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "traccar-pg" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ROUND(AVG(p.speed * 1.852)::numeric, 1) AS \"Velocidad Promedio (km/h)\"\nFROM tc_positions p\nJOIN tc_devices d ON d.positionid = p.id\nWHERE d.disabled = false AND p.speed > 0;",
          "refId": "A"
        }
      ],
      "title": "Velocidad Promedio Flota",
      "type": "stat"
    },
    {
      "datasource": { "type": "postgres", "uid": "traccar-pg" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
